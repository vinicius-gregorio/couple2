// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Local Postgres from `supabase start` (see prisma.config.ts DATABASE_URL).
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  picture   String?
  googleId    String?  @unique
  appleId     String?  @unique
  firebaseUid String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Pairing code for connecting with partner
  pairingCode          String?   @unique
  pairingCodeExpiresAt DateTime?

  // Self-referencing relation for partner/couple
  partnerId String? @unique
  partner   User?   @relation("CouplePartner", fields: [partnerId], references: [id])
  partnerOf User?   @relation("CouplePartner")

  // Pairing requests made by this user
  pairingRequestsSent PairingRequest[] @relation("RequesterRelation")

  // Lists created by this user
  lists PartnerList[]

  // Calendar birthday. Not a CoupleDate — those are shared couple events.
  birthDate DateTime? @db.Date

  // Active couple. Written in the same transaction as partnerId.
  // Null after unpair; ended couples stay in `couples` with status ENDED.
  coupleId   String?
  couple     Couple?   @relation("ActiveCouple", fields: [coupleId], references: [id])
  couplesAsA Couple[]  @relation("CoupleUserA")
  couplesAsB Couple[]  @relation("CoupleUserB")

  // Feed cursor. Unread = partner events with createdAt > feedSeenAt.
  // Null means the feed was never opened, so every partner event counts.
  feedSeenAt DateTime?

  deviceTokens           DeviceToken[]
  notificationPreference NotificationPreference?

  @@map("users")
}


model PairingRequest {
  id          String   @id @default(uuid())
  requesterId String
  targetCode  String
  createdAt   DateTime @default(now())

  // Relation to the user who made the request
  requester User @relation("RequesterRelation", fields: [requesterId], references: [id], onDelete: Cascade)

  // Unique constraint: one user can only have one pending request per target code
  @@unique([requesterId, targetCode])
  @@map("pairing_requests")
}

enum ListType {
  SHOPPING_CART
  MOVIES
  MILESTONES
  TRAVEL
}

enum CoupleStatus {
  ACTIVE
  ENDED
}

enum CoupleDateType {
  CUSTOM
}

enum Recurrence {
  NONE
  YEARLY
}

model Couple {
  id              String       @id @default(uuid())
  userAId         String
  userBId         String
  userA           User         @relation("CoupleUserA", fields: [userAId], references: [id])
  userB           User         @relation("CoupleUserB", fields: [userBId], references: [id])
  members         User[]       @relation("ActiveCouple")
  status          CoupleStatus @default(ACTIVE)
  pairedAt        DateTime     @default(now())
  endedAt         DateTime?
  anniversaryDate DateTime?    @db.Date
  timezone        String       @default("America/Sao_Paulo")
  dates           CoupleDate[]
  lists           PartnerList[]
  activityEvents  ActivityEvent[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userAId, status])
  @@index([userBId, status])
  @@map("couples")
}

model CoupleDate {
  id          String         @id @default(uuid())
  coupleId    String
  couple      Couple         @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  type        CoupleDateType @default(CUSTOM)
  title       String
  date        DateTime       @db.Date
  recurrence  Recurrence     @default(YEARLY)
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([coupleId])
  @@map("couple_dates")
}

model PartnerList {
  id        String     @id @default(uuid())
  type      ListType
  name      String
  ownerId   String
  owner     User       @relation(fields: [ownerId], references: [id])
  // Nullable until a later release. Orphan lists (unpaired owners) stay null
  // and are attached on the next pairing. Lists of an ENDED couple keep that
  // coupleId so neither partner can see them after unpair.
  coupleId  String?
  couple    Couple?    @relation(fields: [coupleId], references: [id], onDelete: Restrict)
  items     ListItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([coupleId])
  @@map("partner_lists")
}

model ListItem {
  id          String      @id @default(uuid())
  listId      String
  list        PartnerList @relation(fields: [listId], references: [id], onDelete: Cascade)
  content     String
  metadata    Json?
  isCompleted Boolean     @default(false)
  addedById   String
  createdAt   DateTime    @default(now())

  @@map("list_items")
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

enum ActivityType {
  LIST_CREATED
  LIST_ITEM_ADDED
  LIST_ITEM_COMPLETED
  COUPLE_DATE_UPCOMING
  COUPLE_UPDATED
  QUESTION_ANSWERED
  QUESTION_UNLOCKED
  MOOD_SHARED
  NUDGE_SENT
  DATE_PLAN_PROPOSED
  DATE_PLAN_ACCEPTED
  DATE_PLAN_DECLINED
  DATE_PLAN_COUNTERED
  DATE_PLAN_CANCELLED
  DATE_PLAN_DONE
}

model DeviceToken {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String         @unique
  platform   DevicePlatform
  appVersion String?
  locale     String?
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())

  @@index([userId])
  @@map("device_tokens")
}

model ActivityEvent {
  id         String       @id @default(uuid())
  coupleId   String
  couple     Couple       @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  actorId    String?
  type       ActivityType
  entityType String
  entityId   String
  payload    Json?
  createdAt  DateTime     @default(now())

  @@index([coupleId, createdAt(sort: Desc)])
  @@index([coupleId, type, entityId])
  @@map("activity_events")
}

model NotificationPreference {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushEnabled    Boolean  @default(true)
  lists          Boolean  @default(true)
  importantDates Boolean  @default(true)
  dailyQuestion  Boolean  @default(true)
  mood           Boolean  @default(true)
  nudges         Boolean  @default(true)
  datePlans      Boolean  @default(true)
  quietStartMin  Int?
  quietEndMin    Int?
  updatedAt      DateTime @updatedAt

  @@map("notification_preferences")
}
