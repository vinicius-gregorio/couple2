# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_min_32_chars

# Firebase Admin — powers both Firestore (data layer) and Firebase ID token
# verification (Google/Apple sign-in). Project: couple42-27692.
# Get the key: Firebase console -> Project settings -> Service accounts
# -> Generate new private key.
#
# Provide it ONE of three ways (checked in this order):
#   1. FIREBASE_SERVICE_ACCOUNT      — inline JSON (raw or base64)
#   2. FIREBASE_SERVICE_ACCOUNT_PATH — path to the JSON file
#   3. ./serviceAccount.json         — default gitignored file in backend root
#
# Recommended for local dev: drop the downloaded key at couple2_backend/serviceAccount.json
FIREBASE_SERVICE_ACCOUNT=
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccount.json