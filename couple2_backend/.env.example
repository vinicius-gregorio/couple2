# JWT Configuration
JWT_SECRET=local-dev-jwt-secret-change-me-32b
PORT=3000

# Production (Railway) uses the same names. Set values in the service, not in git.
# Required there: DATABASE_URL, JWT_SECRET. Railway sets PORT.
# The image sets NODE_ENV=production.
# Optional: FIREBASE_SERVICE_ACCOUNT, PUSH_DRIVER, CORS_ORIGINS
# (comma-separated origins; unset reflects the request origin).
#
# Do not set NODE_TLS_REJECT_UNAUTHORIZED. The image verifies TLS.
# It installs ca-certificates plus Supabase Root 2021 CA
# (certs/supabase-root-2021.crt) and sets NODE_EXTRA_CA_CERTS and SSL_CERT_FILE.

# Local Supabase Postgres. Start it from the repo root with `supabase start`.
# Default Supabase local credentials (no cloud project):
#   user: postgres  password: postgres  db: postgres  host port: 54322
#
# Use 127.0.0.1 when the API runs on the host (`npm run dev`).
# docker compose overrides this with host.docker.internal so the container
# can reach the published Supabase port.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public

# Supabase Cloud (Railway). Keep sslmode=require so the connection is
# encrypted and the certificate is verified (node-postgres treats require
# as verify-full). The pooler certificate is signed by Supabase Root 2021
# CA, not a public CA — the image trusts that root without disabling checks.
#
# This Nest process is long-lived and Railway is IPv4. Use the shared
# pooler in session mode (port 5432), not the direct db.* host (IPv6 unless
# the project has the IPv4 add-on):
#   postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
#
# Transaction mode (port 6543) is for serverless clients. Prisma must turn
# prepared statements off there:
#   postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
#
# Migrations (`prisma migrate deploy`) use the same DATABASE_URL. Session
# mode on 5432 supports them. On 6543, pgbouncer=true is required.

# Firebase Admin — optional, and only for POST /auth/firebase
# (real Google/Apple ID tokens). Project: couple42-f87b6
# (hosting https://couple42-f87b6.web.app). The Railway
# FIREBASE_SERVICE_ACCOUNT must be a service account from this project;
# a key from another Firebase project cannot verify these ID tokens.
# dev-login, pairing, and partner lists do not need a service account.
#
# Provide it ONE of three ways (checked in this order):
#   1. FIREBASE_SERVICE_ACCOUNT      — inline JSON (raw or base64)
#   2. FIREBASE_SERVICE_ACCOUNT_PATH — path to the JSON file
#   3. ./serviceAccount.json         — default gitignored file in backend root
#
# If private_key contains literal \n (two characters) and no real newlines,
# the API rewrites those to newlines before credential.cert(). A key that
# already contains real newlines is left as-is. Logs record project_id and
# client_email only.
FIREBASE_SERVICE_ACCOUNT=
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccount.json

# Push transport. `log` prints the notification and never calls FCM.
# That is the default in development, and also whenever no service account
# is configured. Set `fcm` in production (same service account as
# verifyIdToken; the key needs the firebasecloudmessaging IAM role).
# Project: couple42-f87b6. Upload the APNs key there for iOS.
PUSH_DRIVER=log
